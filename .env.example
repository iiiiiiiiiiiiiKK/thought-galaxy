# ---------------------------------------------------------------------------
# Thought Galaxy environment template.
#
# This project is a static, local-first web app: there are NO secrets and NO
# backend. The only variable below is optional build configuration.
#
# Never commit real credentials. Copy this file to `.env.local` (git-ignored)
# and fill in values locally if you need to.
# ---------------------------------------------------------------------------

# Base path the app is served from.
#   "/"                 -> root deployment (Cloudflare Pages, Vercel, local dev)
#   "/thought-galaxy/"  -> GitHub Pages project site
VITE_BASE_PATH=/
